{
  "manifest_version": 3,
  "name": "Movie Voice - Player lồng tiếng đồng bộ",
  "version": "3.0.0",
  "description": "Mở phim trong player xử lý trước lời thoại, ghép giọng tiếng Việt đồng bộ để xem chung qua Google Meet.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup-sync.html",
    "default_title": "Mở Movie Voice đồng bộ"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
