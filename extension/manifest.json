{
  "manifest_version": 3,
  "name": "Movie Voice - Lồng tiếng phim AI",
  "version": "4.0.0",
  "description": "Lồng tiếng và thuyết minh phim tự động bằng AI, trích xuất âm thanh MSE trực tiếp, không trễ, tối ưu xem chung Google Meet.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cài đặt Movie Voice"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["inject/mse-hook.js"]
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "ISOLATED",
      "js": ["content/detector.js", "content/dub-player.js"],
      "css": ["content.css"]
    }
  ]
}
