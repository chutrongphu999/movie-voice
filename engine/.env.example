# Khởi tạo file cấu hình Engine (Movie Voice Engine)
# Điền API key của bạn vào đây:

# 1. Groq API Key (Miễn phí tại https://console.groq.com)
GROQ_API_KEY=

# 2. Gemini API Key (Miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cấu hình mặc định
PORT=8765
HOST=127.0.0.1
ASR_MODEL=whisper-large-v3-turbo
TRANSLATE_MODEL=gemini-3.1-flash-lite
DEFAULT_VOICE=vi-VN-HoaiMyNeural
